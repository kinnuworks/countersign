{
  "_comment": "Copy to countersign.models.json. API keys are read from the environment at setup time and stored only inside TrueForge, never in this file.",
  "trueforge": {
    "baseUrl": "http://localhost:8790"
  },
  "chain": [
    "anthropic/claude-sonnet-5-5",
    "anthropic-openai/claude-haiku-5-5"
  ],
  "retry": {
    "retries": 2,
    "baseDelayMs": 800
  },
  "providers": [
    {
      "manifest": {
        "type": "anthropic",
        "models": [
          {
            "model_id": "claude-sonnet-5-5",
            "name": "claude-sonnet-5-5",
            "properties": {
              "context_length": 200000,
              "max_output_tokens": 16000
            }
          },
          {
            "model_id": "claude-haiku-5-5",
            "name": "claude-haiku-5-5",
            "properties": {
              "context_length": 200000,
              "max_output_tokens": 16000
            }
          }
        ]
      },
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    },
    {
      "manifest": {
        "type": "custom",
        "name": "anthropic-openai",
        "base_url": "https://api.anthropic.com/v1/",
        "models": [
          {
            "model_id": "claude-haiku-5-5",
            "name": "claude-haiku-5-5",
            "properties": {
              "context_length": 200000,
              "max_output_tokens": 16000
            }
          }
        ]
      },
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "_note": "Anthropic's OpenAI-compatible endpoint, a second provider so the fallback survives a broken anthropic provider"
    },
    {
      "manifest": {
        "type": "custom",
        "name": "ollama",
        "base_url": "http://localhost:11434/v1",
        "models": [
          {
            "model_id": "gemma4:e4b-it-qat",
            "name": "gemma4-e4b",
            "properties": {
              "context_length": 32768,
              "max_output_tokens": 4096
            }
          }
        ]
      },
      "apiKey": "ollama"
    },
    {
      "manifest": {
        "type": "openai",
        "models": [
          {
            "model_id": "gpt-5.4-mini",
            "name": "gpt-5-4-mini",
            "properties": {
              "context_length": 400000,
              "max_output_tokens": 16000
            }
          }
        ]
      },
      "apiKeyEnv": "OPENAI_API_KEY",
      "optional": true
    }
  ]
}